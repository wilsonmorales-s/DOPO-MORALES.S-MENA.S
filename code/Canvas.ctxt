#BlueJ class context
comment0.target=Canvas
comment0.text=\r\n\ Esta\ clase\ se\ encarga\ de\ mostrar\ las\ figuras\ del\ proyecto\ en\ una\ ventana.\r\n\ Es\ una\ version\ adaptada\ del\ Canvas\ usado\ en\ los\ ejemplos\ de\ BlueJ.\r\n
comment1.params=
comment1.target=Canvas\ getCanvas()
comment1.text=Obtiene\ el\ Canvas\ que\ se\ usa\ para\ dibujar\ las\ figuras.
comment2.params=title\ width\ height\ bgColour
comment2.target=Canvas(java.lang.String,\ int,\ int,\ java.awt.Color)
comment2.text=\r\n\ Crea\ la\ ventana\ donde\ se\ van\ a\ mostrar\ las\ figuras.\r\n
comment3.params=visible
comment3.target=void\ setVisible(boolean)
comment3.text=\r\n\ Set\ the\ canvas\ visibility\ and\ brings\ canvas\ to\ the\ front\ of\ screen\r\n\ when\ made\ visible.\ This\ method\ can\ also\ be\ used\ to\ bring\ an\ already\r\n\ visible\ canvas\ to\ the\ front\ of\ other\ windows.\r\n\ @param\ visible\ \ boolean\ value\ representing\ the\ desired\ visibility\ of\r\n\ the\ canvas\ (true\ or\ false)\ \r\n
comment4.params=referenceObject\ color\ shape
comment4.target=void\ draw(java.lang.Object,\ java.lang.String,\ java.awt.Shape)
comment4.text=\r\n\ Dibuja\ una\ figura\ en\ el\ Canvas.\r\n\ @param\ referenceObject\ objeto\ que\ identifica\ la\ figura\r\n\ @param\ color\ color\ de\ la\ figura\r\n\ @param\ shape\ figura\ que\ se\ va\ a\ dibujar\r\n
comment5.params=referenceObject
comment5.target=void\ erase(java.lang.Object)
comment5.text=\r\n\ Quita\ una\ figura\ del\ Canvas.\r\n\ @param\ referenceObject\ figura\ que\ se\ quiere\ quitar\r\n
comment6.params=colorString
comment6.target=void\ setForegroundColor(java.lang.String)
comment6.text=\r\n\ Cambia\ el\ color\ que\ se\ usa\ para\ dibujar.\r\n\ @param\ colorString\ nombre\ del\ color\ que\ se\ quiere\ usar\r\n
comment7.params=milliseconds
comment7.target=void\ wait(int)
comment7.text=\r\n\ Hace\ una\ peque\u00F1a\ pausa,\ principalmente\ para\ las\ animaciones.\r\n\ @param\ milliseconds\ tiempo\ de\ espera\r\n
comment8.params=
comment8.target=void\ redraw()
comment8.text=Vuelve\ a\ dibujar\ las\ figuras\ que\ estan\ en\ el\ Canvas.
comment9.params=
